# Password for the /admin CMS. Change this before deploying.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-random-32-byte-hex-string

# SMTP for enquiry notifications. Without these the site still works and
# enquiries are saved — they just aren't emailed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=LoopWings

# Where enquiry notifications are delivered.
# Optional — defaults to SMTP_FROM_EMAIL, then SMTP_USER.
ENQUIRY_TO_EMAIL=you@example.com

# Public site URL — used for canonical tags, Open Graph images, robots.txt
# and sitemap.xml. Must be the real domain in production.
NEXT_PUBLIC_SITE_URL=https://loopwings.com
